# /etc/sjfire/backup.env 의 본보기 — 실제 값은 VPS에만 둔다 (sudo install -m 600 -o root -g root)
# 이 저장소는 공개다. 실제 값을 이 파일에 적지 말 것.

# Supabase 대시보드 → Project Settings → Database → Connection string → "Session pooler" (포트 5432).
#   직접 접속(db.<ref>.supabase.co)은 IPv6 전용이라 가비아 VPS(IPv4)에서 안 붙는다. 세션 풀러를 쓴다.
#   트랜잭션 풀러(6543)는 pg_dump가 쓰는 prepared statement를 지원하지 않는다 — 5432여야 한다.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 오브젝트 스토리지 버킷(백업 전용으로 하나 새로 만든다). 버전 관리는 켜지 않아도 된다 — storage-deleted/가 그 역할.
BACKUP_BUCKET=sjfire-erp-backup

# rclone 원격 이름 (rclone.conf의 섹션명과 일치)
OBJ_REMOTE=obj     # 오브젝트 스토리지 (NCP Object Storage / R2 / S3)
SUPA_REMOTE=supa   # Supabase Storage S3 엔드포인트
RCLONE_CONFIG=/etc/sjfire/rclone.conf

# 보존 일수 (db/ 와 storage-deleted/)
RETENTION_DAYS=35

# 빈 덤프 방지 하한 (압축 data.sql.gz 바이트). 첫 실행 뒤 실측값의 절반 정도로 올려 둔다.
MIN_DATA_BYTES=20000

# 선택 — healthchecks.io 같은 "안 오면 울리는" 핑 URL. 성공 시 GET, 실패 시 POST ${URL}/fail.
#   A3(Sentry·cron_runs) 전까지 백업 신선도 감시를 이것으로 대신한다. 체크 주기 1일·유예 2시간.
BACKUP_ALERT_URL=
