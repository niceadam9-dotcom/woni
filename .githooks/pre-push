#!/bin/sh
# 회귀 게이트(pre-push) — 빌드 실패면 push 차단, 데이터 불변식은 경고.
# 활성화: git config core.hooksPath .githooks   (저장소당 1회)
# 전체 테스트는 배포 전 `npm run test:all`.

# Windows(MinGit/MSYS)에서는 npm이 bash 런처라 직접 실행이 안 됨 → cmd 경유. 그 외 OS는 sh로.
run() {
  case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*) cmd //c "$1" ;;
    *) sh -c "$1" ;;
  esac
}

echo "[pre-push] 빌드(타입체크) 검사…"
run "cd erp && npm run build" || { echo "❌ [pre-push] 빌드 실패 — push 중단"; exit 1; }

# 한글 폰트 자립 — 저장소가 폰트의 단일 원천이라는 규약을 차단급으로 고정한다.
# 파일 축만 보므로 환경에 기대지 않고 1초 내에 끝난다. 깨지면 운영 이미지가 두부로 인쇄된다.
echo "[pre-push] 한글 폰트 자산 검사…"
run "cd erp && node scripts/assert-korean-glyphs.mjs --files-only" || { echo "❌ [pre-push] 한글 폰트 자산 결함 — push 중단"; exit 1; }

# 스키마 드리프트 — **코드가 지목하는 컬럼이 배포 대상 DB에 없는가**. 차단급이다.
# 2026-09-14에 같은 사고가 하루 두 번 났다(163 `agency_applies`, 그 전 160 `is_primary`):
# 없는 컬럼을 select에 넣으면 PostgREST가 42703으로 **조회 전체를 거절**하고, 그 실패가 null로
# 뭉개져 화면엔 「고객을 찾을 수 없습니다」가 뜬다 — 소방계획서가 엑셀·PDF 양쪽 다 죽는다.
# 「마이그레이션이 먼저 적용돼야 한다」는 주석은 이미 두 번 실패했으므로 여기서 막는다.
# ⚠ 마이그레이션만 먼저 써 두고 코드는 아직 안 쓴 상태는 **통과**시킨다(거짓 차단을 안 만든다).
echo "[pre-push] 스키마 드리프트 검사(코드↔DB)…"
run "cd erp && node scripts/assert-schema-code-drift.mjs .env.production" || { echo "❌ [pre-push] 코드가 DB에 없는 컬럼을 지목 — push 중단"; exit 1; }

echo "[pre-push] 데이터 불변식 검사(경고, 비차단)…"
run "cd erp && node scripts/check-data-invariants.mjs" || echo "⚠ [pre-push] 불변식 위반 감지 — 배포 전 확인 권장(push는 허용)"

echo "✅ [pre-push] 게이트 통과"
exit 0
